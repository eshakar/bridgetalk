# MongoDB: local server or an Atlas URI such as
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=bridgetalk
# Google Gemini API key (https://aistudio.google.com/apikey). Empty = rules engine.
GEMINI_API_KEY=
FRONTEND_ORIGIN=http://localhost:3000
# Optional: primary model and comma-separated fallbacks used when it is overloaded
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash-lite
